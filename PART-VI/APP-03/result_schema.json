{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand Area Recommendation Result",
  "type": "object",
  "required": [
    "schema_version",
    "is_mock",
    "reference_period",
    "display_disclaimer",
    "service_context",
    "ui_copy",
    "brands"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "is_mock": {
      "type": "boolean"
    },
    "reference_period": {
      "type": "string"
    },
    "display_disclaimer": {
      "type": "string"
    },
    "service_context": {
      "type": "object",
      "required": [
        "target_user",
        "primary_job",
        "analyzed_population",
        "user_inputs",
        "decision_flow"
      ]
    },
    "ui_copy": {
      "type": "object",
      "required": [
        "service_title",
        "portfolio_section_title",
        "area_section_title",
        "risk_section_title",
        "disclaimer"
      ]
    },
    "brands": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "brand_id",
          "brand_name",
          "brand_type",
          "dna_summary",
          "decision_summary",
          "recommendations",
          "portfolios"
        ]
      }
    }
  }
}
